# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# JTEC CLOUD DASHBOARD - SUPABASE MUSIC PROJECTS CONFIGURATION
# You can set these environment variables OR configure them live in the dashboard UI.
# Service Role keys and Management API tokens are strictly kept on the server.
# ==============================================================================

# PROJECT 1: NASHEED
SUPABASE_URL_NASHEED=""
SUPABASE_ANON_KEY_NASHEED=""
SUPABASE_SERVICE_ROLE_KEY_NASHEED=""
