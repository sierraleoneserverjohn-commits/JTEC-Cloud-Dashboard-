SUPABASE_MGMT_TOKEN_NASHEED=""
SUPABASE_PROJECT_REF_NASHEED=""
# Configured capacity limit in bytes (e.g. 1073741824 = 1GB; leave empty if unknown)
SUPABASE_STORAGE_LIMIT_NASHEED=""

